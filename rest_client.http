http# 1. Define File Variables
@baseUrl = https://typicode.com
@contentType = application/json

###

# 2. GET Request Example
# Click "Send Request" or the green play icon directly above this line
GET {{baseUrl}}/posts/1 HTTP/1.1
Accept: {{contentType}}

###

# 3. POST Request Example with JSON Body
POST {{baseUrl}}/posts HTTP/1.1
Content-Type: {{contentType}}

{
    "title": "foo",
    "body": "bar",
    "userId": 1
}

###

# 4. PUT Request Example
PUT {{baseUrl}}/posts/1 HTTP/1.1
Content-Type: {{contentType}}

{
    "id": 1,
    "title": "updated title",
    "body": "updated content",
    "userId": 1
}

###

# 5. DELETE Request Example
DELETE {{baseUrl}}/posts/1 HTTP/1.1